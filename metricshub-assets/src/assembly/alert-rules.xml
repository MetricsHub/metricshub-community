<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.0 http://maven.apache.org/xsd/assembly-2.1.0.xsd">
	<id>alert-rules</id>
	<formats>
		<format>zip</format>
	</formats>

	<includeBaseDirectory>false</includeBaseDirectory>

	<fileSets>

		<!-- Prometheus alert rules, also unpacked by MetricsHub Enterprise -->
		<fileSet>
			<directory>src/main/resources/common/alert-rules</directory>
			<outputDirectory>/alert-rules</outputDirectory>
			<fileMode>0644</fileMode>
			<lineEnding>unix</lineEnding>
			<filtered>false</filtered>
		</fileSet>

	</fileSets>

</assembly>
