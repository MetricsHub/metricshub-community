{
  "connector" : "WindowsService",
  "sources" : {
    "${source::monitors.service.simple.sources.serviceInformation}" : {
      "source" : "wmi",
      "computes" : [ "keepOnlyMatchingLines", "translate" ],
      "outputs" : {
        "empty" : {
          "table" : [ ],
          "rawData" : ""
        },
        "table" : {
          "table" : [ [ "a", "unknown", "c" ], [ "x", "unknown", "z", "" ], [ "1", "unknown", "3" ], [ "cell;with;sep", "unknown", "" ], [ "only" ] ],
          "rawData" : "a;unknown;c;\nx;unknown;z;;\n1;unknown;3;\ncell;with;sep;unknown;;\nonly;"
        }
      }
    }
  }
}